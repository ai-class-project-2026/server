DATABASE_URL=sqlite+aiosqlite:///./app.db
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
CORS_ORIGINS=["http://localhost:3000"]
# 웹과 같은 도메인에서 경로로 나눠 배포할 때만 (예: /api). 개발에서는 비운다
API_PREFIX=

# /moderate, /schedule 보호용 (평가 스크립트, 디스코드 봇이 X-API-Key 헤더로 보냄)
AI_API_KEY=
# 일정 모델 서버 (OpenAI 호환: llama.cpp server, vLLM, Ollama 등). 비우면 일정 AI 꺼짐
SCHEDULE_LLM_URL=
SCHEDULE_LLM_MODEL=teamplmate-schedule
SCHEDULE_MODEL_VERSION=v0
SCHEDULE_LLM_TIMEOUT=30
# 욕설 KcELECTRA ONNX 경로 (파트 3). 비우면 사전 필터만
MODERATION_ONNX_PATH=
# 욕설 판정을 다른 서버(같은 코드를 띄운 모델 서버)에 맡길 때만: 주소와 그 서버의 AI_API_KEY. 답이 없으면 위 설정대로 이 서버 안에서 판정
MODERATION_URL=
MODERATION_API_KEY=

# 디스코드 봇 (파트 4, bots/discord/bot.py). 서버는 이 값들을 무시함
DISCORD_TOKEN=
SERVER_URL=http://localhost:8000
